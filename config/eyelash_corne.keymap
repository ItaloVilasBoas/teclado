#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        td_n123: td_n123 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "N1/N2/N3 Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp N2>, <&kp N3>;
        };

        td_n456: td_n456 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "N4/N5/N6 Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp N5>, <&kp N6>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            bindings = <
                &kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T
                &kp UP    &kp Y    &kp U    &kp I    &kp O    &kp P
                &kp BACKSPACE    &kp LEFT_SHIFT    &kp A    &kp S    &kp D    &kp F
                &kp G    &kp LEFT    &kp RETURN    &kp RIGHT    &kp H    &kp J
                &kp K    &kp L    &kp SEMICOLON    &kp SQT    &kp LEFT_CONTROL    &kp Z
                &kp X    &kp C    &kp V    &kp B    &kp C_PLAY_PAUSE    &kp DOWN
                &kp N    &kp M    &kp COMMA    &kp PERIOD    &kp SLASH    &kp BACKSLASH
                &kp LEFT_GUI    &mo 1    &lt 3 SPACE    &mt RIGHT_SHIFT RETURN    &mo 2    &kp RIGHT_ALT
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        number {
            bindings = <
                &kp GRAVE    &kp ESCAPE    &kp U    &kp UP    &kp O    &kp P
                &rgb_ug RGB_BRI    &trans    &kp N7    &kp N8    &kp N9    &trans
                &kp BACKSPACE    &trans    &kp H    &kp LEFT    &kp DOWN    &kp RIGHT
                &kp SEMICOLON    &rgb_ug RGB_EFR    &rgb_ug RGB_TOG    &rgb_ug RGB_EFF    &trans    &kp N4
                &kp N5    &kp N6    &kp HOME    &kp PAGE_UP    &trans    &kp N
                &kp M    &kp COMMA    &kp PERIOD    &kp SLASH    &kp C_MUTE    &rgb_ug RGB_BRD
                &trans    &kp N1    &kp N2    &kp N3    &kp END    &kp PAGE_DOWN
                &trans    &trans    &trans    &kp ESCAPE    &lt 3 N0    &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        symbol {
            bindings = <
                &kp 34013237    &kp 34013214    &kp 34013215    &kp 34013216    &kp 34013217    &kp 34013218
                &kp UP    &kp 34013219    &kp 34013220    &kp 34013221    &kp EQUAL    &kp 34013223
                &kp BACKSPACE    &trans    &trans    &trans    &kp 34013231    &kp 34013222
                &kp LEFT_BRACKET    &kp LEFT    &kp SPACE    &kp RIGHT    &kp 34013229    &trans
                &kp RIGHT_CONTROL    &kp LEFT_ALT    &kp RIGHT_GUI    &kp GRAVE    &trans    &out OUT_USB
                &out OUT_BLE    &kp 34013232    &kp 34013223    &kp RIGHT_BRACKET    &trans    &kp DOWN
                &kp BACKSLASH    &kp MINUS    &kp 34013230    &kp SLASH    &kp 34013240    &trans
                &trans    &mo 3    &kp SPACE    &kp ESCAPE    &trans    &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        fn {
            bindings = <
                &studio_unlock    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5
                &mmv 64336    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
                &kp F11    &trans    &trans    &mkp MB1    &mkp MB3    &mkp MB2
                &trans    &mmv 4216324096    &mkp MB1    &mmv 78643200    &mmv 4216324096    &mmv 1200
                &mmv 64336    &mmv 78643200    &trans    &kp F12    &trans    &sys_reset
                &trans    &bootloader    &trans    &trans    &kp C_MUTE    &mmv 1200
                &trans    &trans    &trans    &trans    &trans    &trans
                &ext_power EP_ON    &to 4    &trans    &kp ESCAPE    &trans    &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        games {
            bindings = <
                &kp ESCAPE    &td_n123    &kp N4    &kp W    &kp R    &kp T
                &kp UP    &kp Y    &kp U    &kp I    &kp O    &kp P
                &kp BACKSPACE    &kp TAB    &td_n456    &kp A    &kp S    &kp D
                &kp G    &kp LEFT    &kp RETURN    &kp RIGHT    &kp H    &kp J
                &kp K    &kp L    &kp SEMICOLON    &kp SQT    &kp LEFT_CONTROL    &kp Z
                &kp X    &kp LEFT    &kp RIGHT    &kp B    &kp SPACE    &kp DOWN
                &kp N    &kp M    &kp COMMA    &kp PERIOD    &kp SLASH    &kp ESCAPE
                &kp LEFT_CONTROL    &kp BACKSPACE    &kp SPACE    &to 0    &mo 0    &to 0
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
